{
  "name": "@local/dsh-obsidian",
  "version": "0.0.1",
  "private": true,
  "description": "Obsidian vault bridge for DeepSeek Harness: sidebar panel, note search, stats and note writing for the agent.",
  "license": "MIT",
  "homepage": "https://github.com/hibernate-pano/dsh-obsidian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibernate-pano/dsh-obsidian.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "obsidian",
    "notes",
    "plugin",
    "pkm"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
